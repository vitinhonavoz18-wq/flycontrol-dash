{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flycontrol-dash",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Fechamento diário dos ciclos de cobrança e cobrança automática pela
  // InfinityPay. Roda 08:00 UTC = 05:00 no horário de Brasília, fora do
  // horário de pico do restaurante.
  "triggers": {
    "crons": ["0 8 * * *"],
  },
}
