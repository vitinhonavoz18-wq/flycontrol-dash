# FlyControl — variáveis de ambiente
#
# Copie para `.env` e preencha com os valores reais.
# O `.env` é ignorado pelo git: NUNCA versione segredos.
#
# Em produção, estes valores vêm dos secrets do GitHub Actions (build) e
# dos secrets do Cloudflare Workers (runtime) — veja .github/workflows/deploy.yml.

# --- Cliente (embutidos no bundle pelo Vite — visíveis no browser) ---
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Servidor (SSR / rotas de API — nunca chegam ao browser) ---
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# Service role: ignora RLS. Só no servidor, só via secret do Cloudflare.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Integração com o SiteCreatorFly ---

# URL base do SiteCreatorFly, usada no provisionamento de restaurantes.
SITECREATORFLY_BASE_URL="https://conectfly.com.br"

# Segredo do /api/internal/provision-restaurant no SiteCreatorFly.
# Deve bater com FL_PROVISION_SECRET no conectfly.
SITECREATORFLY_INTERNAL_TOKEN=""

# Assinatura HMAC dos webhooks enviados ao SiteCreatorFly
# (/api/public/flycontrol-table-closed). Deve ser o MESMO valor do
# FL_WEBHOOK_SECRET no conectfly. Vazio = webhook segue sem assinatura.
FL_WEBHOOK_SECRET=""

# --- Cobrança ---

# Segredo do POST /api/billing/close-cycles, chamado pelo agendador diário.
# Vazio = endpoint desligado (responde 503).
BILLING_CRON_SECRET=""

# --- Checkout da InfinityPay ---
#
# Links de checkout gerados no painel da InfinityPay, um por plano. Precisam
# ser https. Vazio = o cadastro termina no fluxo manual, sem redirecionar
# ninguém para pagamento.
#
# No painel da InfinityPay, configure o redirecionamento de cada checkout para
# a URL de retorno do MESMO plano:
#   PREMIUM -> https://<seu-dominio>/pagamento/premium
#   CENTS   -> https://<seu-dominio>/pagamento/cents
# As duas URLs também aparecem prontas para copiar em /admin/subscriptions.
INFINITYPAY_CHECKOUT_URL_PREMIUM=""
INFINITYPAY_CHECKOUT_URL_CENTS=""

# Ativar a assinatura automaticamente quando o cliente volta do checkout.
#
# LEIA ANTES DE LIGAR: a URL de retorno é fixa, pública e igual para todos os
# clientes — ela não prova pagamento nenhum. Com "true", alguém que inicie um
# cadastro, seja enviado ao checkout e feche a página sem pagar consegue
# liberar a própria conta apenas abrindo a URL de retorno.
#
# Padrão "false": o retorno deixa a assinatura em pending_payment e a ativação
# é feita no painel administrativo.
INFINITYPAY_TRUST_RETURN="false"
