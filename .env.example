# FlyControl — variáveis de ambiente
#
# Copie para `.env` e preencha com os valores reais.
# O `.env` é ignorado pelo git: NUNCA versione segredos.
#
# Em produção, estes valores vêm dos secrets do GitHub Actions (build) e
# dos secrets do Cloudflare Workers (runtime) — veja .github/workflows/deploy.yml.

# --- Cliente (embutidos no bundle pelo Vite — visíveis no browser) ---
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Servidor (SSR / rotas de API — nunca chegam ao browser) ---
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# Service role: ignora RLS. Só no servidor, só via secret do Cloudflare.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Integração com o SiteCreatorFly ---

# URL base do SiteCreatorFly, usada no provisionamento de restaurantes.
SITECREATORFLY_BASE_URL="https://conectfly.com.br"

# Segredo do /api/internal/provision-restaurant no SiteCreatorFly.
# Deve bater com FL_PROVISION_SECRET no conectfly.
SITECREATORFLY_INTERNAL_TOKEN=""

# Endereço público DESTE FlyControl — enviado ao SiteCreatorFly no momento
# do provisionamento, para ele saber para onde mandar os pedidos de volta.
# Vazio = lojas são criadas normalmente, mas nenhum pedido chega ao painel
# (fica preso no site público com "Configuração incompleta no painel").
FLYCONTROL_PUBLIC_URL="https://flycontrol.conectfly.com.br"

# Assinatura HMAC dos webhooks enviados ao SiteCreatorFly
# (/api/public/flycontrol-table-closed). Deve ser o MESMO valor do
# FL_WEBHOOK_SECRET no conectfly. Vazio = webhook segue sem assinatura.
FL_WEBHOOK_SECRET=""

# --- Cobrança ---

# Segredo do POST /api/billing/close-cycles. Preenchido, o próprio Worker já
# chama este endpoint sozinho todo dia (ver "triggers"/"crons" em
# wrangler.jsonc) — não precisa configurar nenhum agendador externo. Fecha os
# ciclos de 30 dias vencidos, calcula o valor e manda a cobrança para a
# InfinityPay automaticamente.
# Vazio = endpoint desligado (responde 503) e nada fecha sozinho.
BILLING_CRON_SECRET=""

# --- Checkout da InfinityPay ---
#
# MODO AUTOMÁTICO (recomendado). Preencha com a sua InfiniteTag (o @ da sua
# conta no app da InfinityPay, sem o "$" na frente). Com isso preenchido, cada
# cadastro gera um link de pagamento próprio já com o retorno e o aviso de
# pagamento configurados sozinhos — nada para colar manualmente no painel da
# InfinityPay. A confirmação chega pelo endpoint /api/webhooks/infinitypay,
# que sempre reconfirma o pagamento diretamente com a InfinityPay antes de
# ativar qualquer assinatura (a InfinityPay não assina esse aviso, então
# confiar nele sozinho seria aceitar a palavra de quem quer que descubra a
# URL). Exige FLYCONTROL_PUBLIC_URL preenchido acima.
INFINITYPAY_HANDLE=""

# MODO MANUAL (compatibilidade). Só é usado quando INFINITYPAY_HANDLE está
# vazio. Links de checkout fixos, criados à mão no painel da InfinityPay, um
# por plano. Precisam ser https. Vazio = o cadastro termina no fluxo manual,
# sem redirecionar ninguém para pagamento.
#
# No painel da InfinityPay, configure o redirecionamento de cada checkout para
# a URL de retorno do MESMO plano:
#   PREMIUM -> https://<seu-dominio>/pagamento/premium
#   CENTS   -> https://<seu-dominio>/pagamento/cents
# As duas URLs também aparecem prontas para copiar em /admin/subscriptions.
INFINITYPAY_CHECKOUT_URL_PREMIUM=""
INFINITYPAY_CHECKOUT_URL_CENTS=""

# Ativar a assinatura automaticamente quando o cliente volta do checkout, sem
# esperar confirmação nenhuma da InfinityPay. Só existe para o MODO MANUAL —
# no modo automático (INFINITYPAY_HANDLE preenchido) a ativação já é
# automática e segura, feita pelo webhook, e esta variável não tem efeito.
#
# LEIA ANTES DE LIGAR: a URL de retorno é fixa, pública e igual para todos os
# clientes — ela não prova pagamento nenhum. Com "true", alguém que inicie um
# cadastro, seja enviado ao checkout e feche a página sem pagar consegue
# liberar a própria conta apenas abrindo a URL de retorno.
#
# Padrão "false": o retorno deixa a assinatura em pending_payment e a ativação
# é feita no painel administrativo.
INFINITYPAY_TRUST_RETURN="false"

# --- Detalhe técnico no erro do cadastro ---
#
# Com "true", quando o cadastro falha a mensagem na tela traz junto o erro do
# banco (código, coluna, restrição). Serve para descobrir a causa na hora, em
# vez de abrir o log do servidor.
#
# Deixe "false" no dia a dia: o cliente não tem o que fazer com "violação de
# restrição pizzerias_plan_billing_pair_check", e o texto revela a estrutura
# do banco. Ligue só enquanto estiver investigando algo, e desligue depois.
#
# Esta chave NÃO cria conta, NÃO ativa assinatura e NÃO libera nada de graça.
# Ela só muda o texto de uma mensagem de erro.
#
# Substituiu SIGNUP_ALLOW_PAYMENT_BYPASS, que criava conta ativa sem
# pagamento. Aquele atalho foi removido: quem quer testar sem pagar usa o
# próprio período gratuito de 30 dias.
SIGNUP_DEBUG_ERRORS="false"

# --- Envio de imagem pelo WhatsApp (aviso de status do pedido) ---
#
# SEM ESTAS DUAS VARIÁVEIS O CLIENTE NÃO RECEBE A ARTE.
#
# Quando o pedido muda de etapa, o painel manda o aviso para o cliente. Para a
# imagem ir como IMAGEM (e não como um endereço escrito na conversa), o
# servidor precisa falar com uma API de WhatsApp de verdade.
#
# Sem elas, o painel cai no caminho antigo: abre a conversa do WhatsApp com o
# texto pronto para o dono enviar à mão — e a arte NÃO vai junto, porque o
# link `wa.me` só carrega texto. A tela avisa isso em voz alta.
#
# O aparelho usado é o que estiver conectado em Marketing → Configurações
# (tabela marketing_whatsapp_instances), um por estabelecimento.
UAZAPI_BASE_URL=""
UAZAPI_TOKEN=""

# De onde o servidor PODE baixar a arte antes de enviá-la. O armazenamento do
# próprio Supabase já entra sozinho; esta lista serve para acrescentar um CDN
# próprio. Nomes separados por vírgula.
#
# Não é firula: sem uma lista fechada, o endereço da arte viraria um controle
# remoto do nosso servidor — ele buscaria o que mandassem, de onde mandassem,
# inclusive endereços internos que ninguém de fora alcança.
FLYSTATUS_MEDIA_HOSTS=""

# --- Faixas progressivas do plano CENTS ---
#
# ENQUANTO ESTA VARIÁVEL ESTIVER VAZIA, NADA MUDA PARA NINGUÉM.
#
# Com uma data preenchida (ex.: "2026-09-01"), os ciclos de cobrança que
# ABRIREM daquele dia em diante passam a usar as faixas progressivas:
#
#   1 a 100 pedidos    -> R$ 0,70 cada
#   101 a 250          -> R$ 0,60 cada
#   251 a 500          -> R$ 0,50 cada
#   501 em diante      -> R$ 0,40 cada
#
# O desconto vale DALI PARA FRENTE, como conta de luz: quem faz 600 pedidos
# não paga R$ 0,40 nos 600 — paga R$ 0,70 nos primeiros 100, R$ 0,60 nos
# seguintes, e assim por diante.
#
# A data existe para não trocar a regra no meio de um ciclo. Ciclo que já
# estava rodando termina com o preço que começou; seria mudar o valor depois
# de o cliente já ter vendido.
CENTS_V2_VIGENCIA=""
